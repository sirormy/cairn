    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/turndown": "^5.0.6",
