# ── LLM（OpenAI 兼容端点，必填）────────────────────────────
# 例如火山方舟: https://ark.cn-beijing.volces.com/api/v3
# 例如 OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
# 模型 / 端点 ID，例如 doubao-seed-1-6-250615 / deepseek-chat
LLM_MODEL=
# 模型显示名（可选）
LLM_MODEL_NAME=

# ── GitHub（可选，提升 API 限额 60/h → 5000/h）──────────────
GITHUB_TOKEN=

# ── X / Twitter 推文抓取兜底（可选）────────────────────────
# 方式一（推荐）：登录 x.com 后用浏览器扩展（EditThisCookie / Get cookies.txt）
# 导出完整 cookie，保存为仓库根目录 x.cookie.json —— 书签一键导入也用它。
# 方式二：从 Cookie 中提取 auth_token 与 ct0 填到下面。
X_AUTH_TOKEN=
X_CT0=
# cookie 文件路径（默认 <仓库根>/x.cookie.json）
# X_COOKIE_FILE=

# ── X GraphQL 接口参数（可选，一般不用动）────────────────────
# 下面几个 queryId / features 是 X Web 端内部接口的参数，X 会不定期轮换。
# 代码里都带了当前可用的默认值，接口报错时再从 twscrape 等开源项目取最新值覆盖。
# X 单推详情接口
# X_GQL_QUERY_ID=
# X_GQL_FEATURES=
# X 书签列表接口
# X_BOOKMARKS_QUERY_ID=
# x.com Web 端公开 Bearer，改动它通常没有意义
# X_BEARER_TOKEN=

# ── 服务（API 端口；web dev 固定 5173 并代理 /api）───────────
API_PORT=8787
# 监听地址，默认 127.0.0.1（仅本机）。接口无鉴权，改成 0.0.0.0
# 会把收藏库和 X 登录态暴露到局域网，务必确认网络环境可信
# HOST=0.0.0.0
