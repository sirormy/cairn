{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn —— 把链接堆成你的知识路标：Agent 驱动的个人内容收录与调研系统",
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "bookmarks",
    "knowledge-base",
    "read-it-later",
    "llm",
    "sqlite",
    "self-hosted"
  ],
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @cairn/server dev\" \"pnpm --filter @cairn/web dev\"",
    "build": "pnpm --filter @cairn/server typecheck && pnpm --filter @cairn/web typecheck && pnpm --filter @cairn/web build && pnpm --filter @cairn/server build",
    "start": "pnpm --filter @cairn/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
